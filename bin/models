#!/usr/bin/env bash
set -euo pipefail

# Homunculus Unified Model CLI — fleet discovery, pull, remove, doctor. Docker-aware.
# Manages both Ollama and llama.cpp drivers. Replaces (but does not remove) bin/ollama.
# Default: requires host Ruby + toml-rb (bundle install), curl. Optional: Docker via BIN_OLLAMA_USE_DOCKER=1.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; exit 1; }

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Optional configuration: BIN_OLLAMA_USE_DOCKER=1, OLLAMA_CONTAINER, AGENT_CONTAINER
[[ -f "$PROJECT_ROOT/config/ollama.env" ]] && source "$PROJECT_ROOT/config/ollama.env"
# Normalize so "1", "1 ", " 1" or "1" with CRLF all count as enabled
BIN_OLLAMA_USE_DOCKER="${BIN_OLLAMA_USE_DOCKER:-0}"
BIN_OLLAMA_USE_DOCKER="${BIN_OLLAMA_USE_DOCKER//[[:space:]]}"

MODELS_TOML="$PROJECT_ROOT/config/models.toml"
DEFAULT_TOML="$PROJECT_ROOT/config/default.toml"
OLLAMA_CONTAINER="${OLLAMA_CONTAINER:-homunculus-ollama}"
AGENT_CONTAINER="${AGENT_CONTAINER:-homunculus-agent}"
LLAMACPP_CONTAINER="${LLAMACPP_CONTAINER:-homunculus-llamacpp}"
OLLAMA_INSTALLED_IN_WORKSPACE="$PROJECT_ROOT/workspace/.ollama_installed.json"
LLAMACPP_MODELS_IN_WORKSPACE="$PROJECT_ROOT/workspace/.llamacpp_models.json"

# Default llama.cpp base URL; overridden by LLAMACPP_BASE_URL env
LLAMACPP_BASE_URL="${LLAMACPP_BASE_URL:-http://127.0.0.1:8080}"

export MODELS_TOML DEFAULT_TOML

# ── Container helpers ────────────────────────────────────────────────────────

require_docker_containers() {
  [[ "${BIN_OLLAMA_USE_DOCKER:-0}" != "1" ]] && return 0
  if ! docker ps --filter "name=$AGENT_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
    error "BIN_OLLAMA_USE_DOCKER=1 but $AGENT_CONTAINER is not running. Start with: bin/assistant up"
  fi
}

host_ruby_available() {
  (cd "$PROJECT_ROOT" && bundle exec ruby -e "exit 0") 2>/dev/null
}

ensure_ruby_or_docker() {
  [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && return 0
  if host_ruby_available; then
    return 0
  fi
  warn "Host Ruby not available. Using Docker mode."
  BIN_OLLAMA_USE_DOCKER=1
  require_docker_containers
}

# ── Fleet JSON helpers ───────────────────────────────────────────────────────

get_fleet_json() {
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    docker exec "$AGENT_CONTAINER" bash -c \
      'MODELS_TOML=/app/config/models.toml DEFAULT_TOML=/app/config/default.toml bundle exec ruby /app/bin/models_fleet_parser.rb'
  else
    cd "$PROJECT_ROOT" && bundle exec ruby bin/models_fleet_parser.rb
  fi
}

# Outputs the model name for the given tier (stdin = fleet JSON).
tier_to_model() {
  local tier="$1"
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    docker exec -i "$AGENT_CONTAINER" ruby -r json \
      -e "t=ARGV[0]; f=JSON.parse(STDIN.read); e=f.find{|x|x['tier']==t}; puts e['model'] if e" "$tier"
  else
    ruby -r json \
      -e "t=ARGV[0]; f=JSON.parse(STDIN.read); e=f.find{|x|x['tier']==t}; puts e['model'] if e" "$tier"
  fi
}

# Outputs the driver for the given tier (stdin = fleet JSON).
tier_to_driver() {
  local tier="$1"
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    docker exec -i "$AGENT_CONTAINER" ruby -r json \
      -e "t=ARGV[0]; f=JSON.parse(STDIN.read); e=f.find{|x|x['tier']==t}; puts e['driver'] if e" "$tier"
  else
    ruby -r json \
      -e "t=ARGV[0]; f=JSON.parse(STDIN.read); e=f.find{|x|x['tier']==t}; puts e['driver'] if e" "$tier"
  fi
}

# Comma-separated list of valid tier names (stdin = fleet JSON).
valid_tiers() {
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    docker exec -i "$AGENT_CONTAINER" ruby -r json \
      -e "f=JSON.parse(STDIN.read); puts f.map{|x| x['tier']}.join(', ')"
  else
    ruby -r json -e "f=JSON.parse(STDIN.read); puts f.map{|x| x['tier']}.join(', ')"
  fi
}

# Ollama missing models — prints model names one per line (stdin = fleet JSON, needs INSTALLED_JSON env).
missing_ollama_models() {
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    docker exec -i -e INSTALLED_JSON=/app/workspace/.ollama_installed.json "$AGENT_CONTAINER" ruby -r json -e "
      fleet   = JSON.parse(STDIN.read).select { |e| e['driver'] == 'ollama' }
      inst    = File.file?(ENV['INSTALLED_JSON'].to_s) ? JSON.parse(File.read(ENV['INSTALLED_JSON'])) : {'models'=>[]}
      names   = (inst['models']||[]).map{|m| m['name']}.to_set
      fleet.each { |e| puts e['model'] unless names.include?(e['model']) || names.include?(\"#{e['model']}:latest\") }
    "
  else
    ruby -r json -e "
      fleet   = JSON.parse(STDIN.read).select { |e| e['driver'] == 'ollama' }
      inst    = File.file?(ENV['INSTALLED_JSON'].to_s) ? JSON.parse(File.read(ENV['INSTALLED_JSON'])) : {'models'=>[]}
      names   = (inst['models']||[]).map{|m| m['name']}.to_set
      fleet.each { |e| puts e['model'] unless names.include?(e['model']) || names.include?(\"#{e['model']}:latest\") }
    "
  fi
}

# ── Ollama probe ─────────────────────────────────────────────────────────────

OLLAMA_VIA_DOCKER=""
OLLAMA_INSTALLED_FILE=""

ensure_ollama_installed_json() {
  OLLAMA_VIA_DOCKER=""
  OLLAMA_INSTALLED_FILE=""
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" != "1" ]]; then
    if curl -s -f --connect-timeout 2 -o /dev/null -w "%{http_code}" "http://127.0.0.1:11434/api/tags" 2>/dev/null | grep -q 200; then
      OLLAMA_INSTALLED_FILE=$(mktemp)
      curl -s "http://127.0.0.1:11434/api/tags" > "$OLLAMA_INSTALLED_FILE"
      return 0
    fi
  fi
  if docker ps --filter "name=$OLLAMA_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
    OLLAMA_VIA_DOCKER=1
    OLLAMA_INSTALLED_FILE=$(mktemp)
    if docker ps --filter "name=$AGENT_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
      docker exec "$AGENT_CONTAINER" ruby -r net/http -r uri -e \
        'u=URI("http://ollama:11434/api/tags"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
        > "$OLLAMA_INSTALLED_FILE" 2>/dev/null || true
    else
      docker exec "$OLLAMA_CONTAINER" ruby -r net/http -r uri -e \
        'u=URI("http://127.0.0.1:11434/api/tags"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
        > "$OLLAMA_INSTALLED_FILE" 2>/dev/null || true
    fi
    if [[ -s "$OLLAMA_INSTALLED_FILE" ]] && [[ "$(head -c1 "$OLLAMA_INSTALLED_FILE")" == "{" ]]; then
      if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
        mkdir -p "$PROJECT_ROOT/workspace"
        cp "$OLLAMA_INSTALLED_FILE" "$OLLAMA_INSTALLED_IN_WORKSPACE"
      fi
      return 0
    fi
    rm -f "$OLLAMA_INSTALLED_FILE"
  fi
  return 1
}

ollama_cmd() {
  if [[ -n "${OLLAMA_VIA_DOCKER:-}" ]]; then
    docker exec "$OLLAMA_CONTAINER" ollama "$@"
  else
    command ollama "$@"
  fi
}

ollama_pull_cmd() {
  local model="$1"
  if [[ -n "${OLLAMA_VIA_DOCKER:-}" ]]; then
    docker exec -it "$OLLAMA_CONTAINER" ollama pull "$model"
  else
    ollama pull "$model"
  fi
}

ollama_rm_cmd() {
  local model="$1"
  if [[ -n "${OLLAMA_VIA_DOCKER:-}" ]]; then
    docker exec "$OLLAMA_CONTAINER" ollama rm "$model"
  else
    ollama rm "$model"
  fi
}

# ── llama.cpp probe ──────────────────────────────────────────────────────────

LLAMACPP_REACHABLE=0
LLAMACPP_MODELS_FILE=""

ensure_llamacpp_models_json() {
  LLAMACPP_REACHABLE=0
  LLAMACPP_MODELS_FILE=""

  local url="${LLAMACPP_BASE_URL}/v1/models"

  # Try host first (unless Docker-only mode)
  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" != "1" ]]; then
    local code
    code=$(curl -s -f --connect-timeout 2 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || true)
    if [[ "$code" == "200" ]]; then
      LLAMACPP_REACHABLE=1
      LLAMACPP_MODELS_FILE=$(mktemp)
      curl -s "$url" > "$LLAMACPP_MODELS_FILE"
      return 0
    fi
  fi

  # Try Docker container
  if docker ps --filter "name=$LLAMACPP_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
    LLAMACPP_MODELS_FILE=$(mktemp)
    if docker ps --filter "name=$AGENT_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
      docker exec "$AGENT_CONTAINER" ruby -r net/http -r uri -e \
        'u=URI("http://llamacpp:8080/v1/models"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
        > "$LLAMACPP_MODELS_FILE" 2>/dev/null || true
    else
      docker exec "$LLAMACPP_CONTAINER" ruby -r net/http -r uri -e \
        'u=URI("http://127.0.0.1:8080/v1/models"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
        > "$LLAMACPP_MODELS_FILE" 2>/dev/null || true
    fi
    if [[ -s "$LLAMACPP_MODELS_FILE" ]] && [[ "$(head -c1 "$LLAMACPP_MODELS_FILE")" == "{" ]]; then
      LLAMACPP_REACHABLE=1
      if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
        mkdir -p "$PROJECT_ROOT/workspace"
        cp "$LLAMACPP_MODELS_FILE" "$LLAMACPP_MODELS_IN_WORKSPACE"
      fi
      return 0
    fi
    rm -f "$LLAMACPP_MODELS_FILE"
  fi
  return 1
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_list() {
  ensure_ruby_or_docker
  require_docker_containers

  local fleet_json
  fleet_json=$(get_fleet_json)

  local ollama_ok=0 llamacpp_ok=0
  local ollama_env_arg="" llamacpp_env_arg=""

  if ensure_ollama_installed_json; then
    ollama_ok=1
    ollama_env_arg="$OLLAMA_INSTALLED_FILE"
    if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
      ollama_env_arg="/app/workspace/.ollama_installed.json"
    fi
  else
    warn "Ollama not reachable (tried 127.0.0.1:11434 and docker $OLLAMA_CONTAINER)."
  fi

  if ensure_llamacpp_models_json; then
    llamacpp_ok=1
    llamacpp_env_arg="$LLAMACPP_MODELS_FILE"
    if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
      llamacpp_env_arg="/app/workspace/.llamacpp_models.json"
    fi
  fi

  echo "Homunculus Model Fleet"
  echo "══════════════════════════════════════════════════════════════════════════════════════════════"
  echo ""

  if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
    echo "$fleet_json" | docker exec -i \
      -e OLLAMA_INSTALLED_JSON="$ollama_env_arg" \
      -e LLAMACPP_MODELS_JSON="$llamacpp_env_arg" \
      "$AGENT_CONTAINER" bundle exec ruby /app/bin/models_list_table.rb
  else
    echo "$fleet_json" | \
      OLLAMA_INSTALLED_JSON="$ollama_env_arg" \
      LLAMACPP_MODELS_JSON="$llamacpp_env_arg" \
      bundle exec ruby "$PROJECT_ROOT/bin/models_list_table.rb"
  fi

  rm -f "$OLLAMA_INSTALLED_FILE" "$LLAMACPP_MODELS_FILE"
  [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE" "$LLAMACPP_MODELS_IN_WORKSPACE"
}

cmd_status() {
  ensure_ruby_or_docker
  require_docker_containers

  echo "Homunculus — Provider Status"
  echo "════════════════════════════"
  echo ""

  # Ollama
  echo -e "  ${CYAN}Ollama${NC}"
  if ensure_ollama_installed_json; then
    if [[ -n "${OLLAMA_VIA_DOCKER:-}" ]]; then
      info "  Reachable via Docker container: $OLLAMA_CONTAINER"
    else
      info "  Reachable at 127.0.0.1:11434"
    fi
    local fleet_json total expected
    fleet_json=$(get_fleet_json)
    if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
      expected=$(echo "$fleet_json" | docker exec -i "$AGENT_CONTAINER" ruby -r json \
        -e "puts JSON.parse(STDIN.read).count{|e|e['driver']=='ollama'}")
      total=$(docker exec -e OLLAMA_INSTALLED_FILE=/app/workspace/.ollama_installed.json "$AGENT_CONTAINER" ruby -r json \
        -e "begin; d=JSON.parse(File.read(ENV['OLLAMA_INSTALLED_FILE'])); puts (d['models']||[]).size; rescue; puts 0; end")
    else
      expected=$(echo "$fleet_json" | ruby -r json -e "puts JSON.parse(STDIN.read).count{|e|e['driver']=='ollama'}")
      total=$(ruby -r json \
        -e "begin; d=JSON.parse(File.read(ENV['OLLAMA_INSTALLED_FILE'])); puts (d['models']||[]).size; rescue; puts 0; end")
    fi
    echo "    Fleet: $total/$expected Ollama models installed (fleet-only view)"
    rm -f "$OLLAMA_INSTALLED_FILE"
    [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
  else
    echo -e "    ${RED}✗${NC} Not reachable. Start Ollama or: bin/assistant up --with-ollama"
  fi

  echo ""

  # llama.cpp
  echo -e "  ${CYAN}llama.cpp${NC}"
  if ensure_llamacpp_models_json; then
    info "  Reachable at ${LLAMACPP_BASE_URL}"
    local loaded_count
    if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
      loaded_count=$(docker exec -e LLAMACPP_MODELS_JSON=/app/workspace/.llamacpp_models.json "$AGENT_CONTAINER" ruby -r json \
        -e "begin; d=JSON.parse(File.read(ENV['LLAMACPP_MODELS_JSON'])); puts (d['data']||[]).size; rescue; puts 0; end")
    else
      loaded_count=$(LLAMACPP_MODELS_FILE="$LLAMACPP_MODELS_FILE" ruby -r json \
        -e "begin; d=JSON.parse(File.read(ENV['LLAMACPP_MODELS_FILE'])); puts (d['data']||[]).size; rescue; puts 0; end")
    fi
    echo "    Loaded models: ${loaded_count:-0}"
    rm -f "$LLAMACPP_MODELS_FILE"
    [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$LLAMACPP_MODELS_IN_WORKSPACE"
  else
    echo -e "    ${YELLOW}—${NC} Not reachable at ${LLAMACPP_BASE_URL} (optional provider)"
    echo "    Start: bin/assistant up --with-llamacpp  (or set LLAMACPP_BASE_URL in .env)"
  fi

  echo ""
}

cmd_pull() {
  ensure_ruby_or_docker
  require_docker_containers

  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    error "Usage: bin/models pull <tier> | bin/models pull --all"
  fi

  local fleet_json
  fleet_json=$(get_fleet_json)

  if [[ "$arg" == "--all" ]]; then
    # Pull all missing Ollama tiers
    if ! ensure_ollama_installed_json; then
      error "Ollama not reachable. Cannot pull. Start Ollama or: bin/assistant up --with-ollama"
    fi
    export INSTALLED_JSON="$OLLAMA_INSTALLED_FILE"
    local missing
    missing=$(echo "$fleet_json" | missing_ollama_models)
    rm -f "$OLLAMA_INSTALLED_FILE"
    [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
    if [[ -z "$missing" ]]; then
      info "All Ollama fleet models already installed."
      return 0
    fi
    warn "llama.cpp tiers require manual GGUF download — see: bin/models pull <tier>"
    while IFS= read -r model; do
      [[ -z "$model" ]] && continue
      info "Pulling $model..."
      ollama_pull_cmd "$model"
    done <<< "$missing"
    return 0
  fi

  local model driver
  model=$(echo "$fleet_json" | tier_to_model "$arg")
  driver=$(echo "$fleet_json" | tier_to_driver "$arg")

  if [[ -z "$model" ]]; then
    local valid
    valid=$(echo "$fleet_json" | valid_tiers)
    error "Unknown tier: $arg. Valid tiers: $valid"
  fi

  case "$driver" in
    ollama)
      if ! ensure_ollama_installed_json; then
        OLLAMA_VIA_DOCKER=""
        if docker ps --filter "name=$OLLAMA_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
          OLLAMA_VIA_DOCKER=1
        fi
      else
        rm -f "$OLLAMA_INSTALLED_FILE"
        [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
      fi
      info "Pulling $model (tier: $arg, driver: ollama)..."
      ollama_pull_cmd "$model"
      ;;
    llamacpp)
      echo ""
      echo -e "  ${CYAN}llama.cpp — Manual GGUF Installation${NC}"
      echo "  ─────────────────────────────────────"
      echo "  Tier  : $arg"
      echo "  Model : $model"
      echo ""
      echo "  llama.cpp models are GGUF files managed manually. Steps:"
      echo ""
      echo "  1. Find a GGUF file matching your model on Hugging Face:"
      echo "     https://huggingface.co/models?search=$(echo "$model" | tr ' ' '+')"
      echo ""
      echo "  2. Download with wget or huggingface-cli:"
      echo "     wget -O $model.gguf <HuggingFace_URL>"
      echo "     # or: pip install huggingface-hub && huggingface-cli download <repo> <file>"
      echo ""
      echo "  3. Place the file in the llama.cpp models directory:"
      echo "     - Docker volume  : docker cp $model.gguf $LLAMACPP_CONTAINER:/models/"
      echo "     - Host path      : copy to the path mounted at /models in your llama.cpp container"
      echo ""
      echo "  4. Restart llama-server pointing to the new file:"
      echo "     docker exec $LLAMACPP_CONTAINER llama-server --model /models/$model.gguf --port 8080"
      echo ""
      echo "  5. Verify: bin/models status"
      echo ""
      ;;
    *)
      error "Unknown driver '$driver' for tier '$arg'."
      ;;
  esac
}

cmd_remove() {
  ensure_ruby_or_docker
  require_docker_containers

  local tier="${1:-}"
  if [[ -z "$tier" ]]; then
    error "Usage: bin/models remove <tier>"
  fi

  local fleet_json model driver
  fleet_json=$(get_fleet_json)
  model=$(echo "$fleet_json" | tier_to_model "$tier")
  driver=$(echo "$fleet_json" | tier_to_driver "$tier")

  if [[ -z "$model" ]]; then
    local valid
    valid=$(echo "$fleet_json" | valid_tiers)
    error "Unknown tier: $tier. Valid tiers: $valid"
  fi

  case "$driver" in
    ollama)
      # Probe installed size for confirmation prompt (mirrors bin/ollama behavior)
      if ! ensure_ollama_installed_json; then
        OLLAMA_VIA_DOCKER=""
        if docker ps --filter "name=$OLLAMA_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
          OLLAMA_VIA_DOCKER=1
          OLLAMA_INSTALLED_FILE=$(mktemp)
          if docker ps --filter "name=$AGENT_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q .; then
            docker exec "$AGENT_CONTAINER" ruby -r net/http -r uri -e \
              'u=URI("http://ollama:11434/api/tags"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
              > "$OLLAMA_INSTALLED_FILE" 2>/dev/null || true
          else
            docker exec "$OLLAMA_CONTAINER" ruby -r net/http -r uri -e \
              'u=URI("http://127.0.0.1:11434/api/tags"); r=Net::HTTP.get_response(u); puts r.body if r.is_a?(Net::HTTPSuccess)' \
              > "$OLLAMA_INSTALLED_FILE" 2>/dev/null || true
          fi
          if [[ ! -s "$OLLAMA_INSTALLED_FILE" ]] || [[ "$(head -c1 "$OLLAMA_INSTALLED_FILE")" != "{" ]]; then
            rm -f "$OLLAMA_INSTALLED_FILE"
            OLLAMA_INSTALLED_FILE=""
          fi
        fi
      fi

      local size_bytes size_human
      if [[ -n "${OLLAMA_INSTALLED_FILE:-}" ]] && [[ -s "$OLLAMA_INSTALLED_FILE" ]]; then
        if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
          [[ -s "$OLLAMA_INSTALLED_IN_WORKSPACE" ]] || cp "$OLLAMA_INSTALLED_FILE" "$OLLAMA_INSTALLED_IN_WORKSPACE"
          size_bytes=$(docker exec \
            -e INSTALLED_JSON=/app/workspace/.ollama_installed.json \
            -e MODEL="$model" "$AGENT_CONTAINER" ruby -r json \
            -e "d=JSON.parse(File.read(ENV['INSTALLED_JSON'])); m=(d['models']||[]).find{|x|x['name']==ENV['MODEL']}; puts m ? m['size'].to_i : 0")
        else
          size_bytes=$(INSTALLED_JSON="$OLLAMA_INSTALLED_FILE" MODEL="$model" ruby -r json \
            -e "d=JSON.parse(File.read(ENV['INSTALLED_JSON'])); m=(d['models']||[]).find{|x|x['name']==ENV['MODEL']}; puts m ? m['size'].to_i : 0")
        fi
        if [[ -z "$size_bytes" ]] || [[ "$size_bytes" -eq 0 ]]; then
          info "Model $model is not installed."
          rm -f "$OLLAMA_INSTALLED_FILE"
          [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
          return 0
        fi
        if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
          size_human=$(docker exec -e SIZE_BYTES="$size_bytes" "$AGENT_CONTAINER" ruby \
            -e "b=ENV['SIZE_BYTES'].to_i; gb=b/(1024.0**3); puts gb>=1 ? \"#{gb.round(1)} GB\" : \"#{(b/(1024.0**2)).round(0)} MB\"")
        else
          size_human=$(SIZE_BYTES="$size_bytes" ruby \
            -e "b=ENV['SIZE_BYTES'].to_i; gb=b/(1024.0**3); puts gb>=1 ? \"#{gb.round(1)} GB\" : \"#{(b/(1024.0**2)).round(0)} MB\"")
        fi
        rm -f "$OLLAMA_INSTALLED_FILE"
        [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
      else
        info "Model $model is not installed."
        return 0
      fi

      echo -n "Remove $model ($size_human)? [y/N] "
      read -r confirm
      if [[ "${confirm:-}" =~ ^[yY]$ ]]; then
        ollama_rm_cmd "$model"
        info "Removed $model"
      else
        info "Cancelled."
      fi
      ;;
    llamacpp)
      echo ""
      echo -e "  ${CYAN}llama.cpp — Manual GGUF Removal${NC}"
      echo "  ────────────────────────────────"
      echo "  Tier  : $tier"
      echo "  Model : $model"
      echo ""
      echo "  llama.cpp GGUF files are managed manually. To remove:"
      echo ""
      echo "  1. Stop the llama-server if it has the model loaded:"
      echo "     docker stop $LLAMACPP_CONTAINER"
      echo ""
      echo "  2. Remove the GGUF file from your models directory:"
      echo "     docker exec $LLAMACPP_CONTAINER rm /models/$model.gguf"
      echo "     # or: rm <host-models-path>/$model.gguf"
      echo ""
      echo "  3. Restart with a different model or leave stopped."
      echo ""
      ;;
    *)
      error "Unknown driver '$driver' for tier '$tier'."
      ;;
  esac
}

cmd_doctor() {
  ensure_ruby_or_docker
  require_docker_containers

  echo "Homunculus — Extended Diagnostics"
  echo "══════════════════════════════════"
  echo ""

  # Docker
  echo -e "  ${CYAN}Docker${NC}"
  if docker info > /dev/null 2>&1; then
    info "  Docker is running"
    local agent_status ollama_status llamacpp_status
    agent_status=$(docker ps --filter "name=$AGENT_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q . && echo "running" || echo "stopped")
    ollama_status=$(docker ps --filter "name=$OLLAMA_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q . && echo "running" || echo "stopped")
    llamacpp_status=$(docker ps --filter "name=$LLAMACPP_CONTAINER" --filter "status=running" -q 2>/dev/null | grep -q . && echo "running" || echo "stopped")
    echo "    $AGENT_CONTAINER    : $agent_status"
    echo "    $OLLAMA_CONTAINER   : $ollama_status"
    echo "    $LLAMACPP_CONTAINER : $llamacpp_status"
  else
    echo -e "    ${RED}✗${NC} Docker not running or not accessible"
  fi
  echo ""

  # GPU
  echo -e "  ${CYAN}GPU / VRAM${NC}"
  if command -v nvidia-smi > /dev/null 2>&1; then
    local gpu_name vram_total vram_used
    gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "unknown")
    vram_total=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | head -1 || echo "?")
    vram_used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader 2>/dev/null | head -1 || echo "?")
    info "  NVIDIA GPU: $gpu_name"
    echo "    VRAM total: $vram_total"
    echo "    VRAM used : $vram_used"
  elif command -v rocm-smi > /dev/null 2>&1; then
    info "  AMD GPU detected (rocm-smi present)"
    rocm-smi --showmeminfo vram 2>/dev/null || echo "    (rocm-smi output not parseable)"
  else
    echo "    No NVIDIA/AMD GPU tooling found (CPU-only or GPU not exposed to host)"
  fi
  echo ""

  # Ollama health
  echo -e "  ${CYAN}Ollama${NC}"
  if ensure_ollama_installed_json; then
    if [[ -n "${OLLAMA_VIA_DOCKER:-}" ]]; then
      info "  Reachable via Docker: $OLLAMA_CONTAINER"
    else
      info "  Reachable at 127.0.0.1:11434"
    fi
    local fleet_json
    fleet_json=$(get_fleet_json)
    if [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]]; then
      echo "$fleet_json" | docker exec -i \
        -e OLLAMA_INSTALLED_JSON=/app/workspace/.ollama_installed.json \
        -e LLAMACPP_MODELS_JSON="" \
        "$AGENT_CONTAINER" bundle exec ruby /app/bin/models_list_table.rb 2>/dev/null || true
    else
      echo "$fleet_json" | \
        OLLAMA_INSTALLED_JSON="$OLLAMA_INSTALLED_FILE" \
        LLAMACPP_MODELS_JSON="" \
        bundle exec ruby "$PROJECT_ROOT/bin/models_list_table.rb" 2>/dev/null || true
    fi
    rm -f "$OLLAMA_INSTALLED_FILE"
    [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$OLLAMA_INSTALLED_IN_WORKSPACE"
  else
    echo -e "    ${RED}✗${NC} Ollama not reachable"
  fi

  # llama.cpp health
  echo -e "  ${CYAN}llama.cpp${NC}"
  if ensure_llamacpp_models_json; then
    info "  Reachable at ${LLAMACPP_BASE_URL}"
    if [[ -s "${LLAMACPP_MODELS_FILE:-}" ]]; then
      echo "    Loaded models:"
      ruby -r json -e "
        d = JSON.parse(File.read('$LLAMACPP_MODELS_FILE'))
        (d['data'] || []).each { |m| puts \"      - #{m['id']}\" }
      " 2>/dev/null || echo "      (could not parse response)"
    fi
    rm -f "$LLAMACPP_MODELS_FILE"
    [[ "${BIN_OLLAMA_USE_DOCKER:-0}" == "1" ]] && rm -f "$LLAMACPP_MODELS_IN_WORKSPACE"
  else
    echo -e "    ${YELLOW}—${NC} Not reachable at ${LLAMACPP_BASE_URL} (optional)"
  fi
  echo ""
}

cmd_help() {
  cat <<EOF
Usage: bin/models [command] [args]

Unified model management for Ollama and llama.cpp drivers.
Fleet defined in config/models.toml. Provider settings in config/default.toml.

Fleet:

  list                Show all tiers with driver and install status (default)
  status              Health check all configured providers

Install / remove:

  pull <tier>         Ollama: pull model. llama.cpp: print GGUF download instructions.
  pull --all          Pull all missing Ollama models (llama.cpp tiers: prints notice)
  remove <tier>       Ollama: remove model (with confirmation). llama.cpp: print removal steps.

Diagnostics:

  doctor              Extended: Docker, GPU/VRAM, provider health, loaded models
  help                Show this help

Configuration (optional): config/ollama.env (copy from config/ollama.env.example)
  BIN_OLLAMA_USE_DOCKER=1   Run via Docker containers (no host Ruby/Ollama needed).
                            Requires: bin/assistant up  (agent container must be running).
  OLLAMA_CONTAINER          Override Ollama container name (default: homunculus-ollama)
  AGENT_CONTAINER           Override agent container name  (default: homunculus-agent)
  LLAMACPP_CONTAINER        Override llama.cpp container name (default: homunculus-llamacpp)
  LLAMACPP_BASE_URL         Override llama.cpp server URL (default: http://127.0.0.1:8080)
                            Also reads LLAMACPP_BASE_URL from .env.

Examples:
  bin/models
  bin/models list
  bin/models status
  bin/models pull workhorse
  bin/models pull --all
  bin/models remove thinker
  bin/models doctor
EOF
}

# ── Dispatch ─────────────────────────────────────────────────────────────────

COMMAND="${1:-list}"
shift || true

case "$COMMAND" in
  list)            cmd_list "$@" ;;
  status)          cmd_status "$@" ;;
  pull)            cmd_pull "$@" ;;
  remove)          cmd_remove "$@" ;;
  doctor)          cmd_doctor "$@" ;;
  help|--help|-h)  cmd_help ;;
  *)
    error "Unknown command: $COMMAND. Run 'bin/models help' for usage."
    ;;
esac
